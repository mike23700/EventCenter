VITE_SUPABASE_URL=https://hrcpdqmxragasfmuswuu.supabase.co
VITE_SUPABASE_ANON_KEY=COLLEZ_ICI_LA_CLE_ANON_PUBLISHABLE_DU_DASHBOARD

# URL du site de production (pour génération de liens complets)
VITE_SITE_URL=http://localhost:5173

# NB : la clé service_role NE DOIT PLUS être utilisée dans le frontend.
# La création des comptes clients passe par l'Edge Function 'create-client-account',
# qui la garde côté serveur. Définissez-la comme secret : supabase functions deploy /
# supabase secrets set SERVICE_ROLE_KEY=<la clé> (voir supabase/functions/create-client-account).
# Copiez ce fichier vers .env et complétez avec les infos de la base Postgres o2switch.
DATABASE_URL=postgres://user:password@localhost:5432/eventcenter

# Chaîne aléatoire longue, jamais partagée (sert à signer le cookie de session).
SESSION_SECRET=change-me-to-a-long-random-string

# "true" en production (HTTPS) — le cookie de session n'est alors envoyé qu'en HTTPS.
COOKIE_SECURE=false

# Port d'écoute local (Passenger sur o2switch fixe généralement PORT lui-même en prod).
PORT=4000

# Dossier où sont écrits les fichiers uploadés (servis ensuite en statique par Apache
# depuis public_html/uploads en prod ; en local, un dossier quelconque suffit).
UPLOADS_DIR=../public/uploads

# "true" : applique automatiquement les migrations en attente (server/sql/migrations)
# au démarrage de l'API. Sinon, les lancer à la main : npm run migrate
AUTO_MIGRATE=false
